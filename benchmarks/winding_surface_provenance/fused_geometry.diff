+def _surface_point_and_normal(rsurfacecc, zsurfacecs, nfp, tor_angle,
+                              pol_angle, n_min=None, m_min=0):
+    """Evaluate a stellarator-symmetric point and normal from one basis.
+
+    ``points_normals_normal_lengths`` needs R, Z, and four first derivatives
+    at every quadrature point.  Calling the public scalar helpers separately
+    builds the same Fourier angle and evaluates its sine/cosine six times.
+    This fused internal path shares that basis while leaving the independently
+    useful public helpers unchanged.
+    """
+    rsurfacecc = jnp.asarray(rsurfacecc)
+    zsurfacecs = jnp.asarray(zsurfacecs)
+    if rsurfacecc.shape != zsurfacecs.shape:
+        raise ValueError("R-cosine and Z-sine coefficients must match.")
+    num_m_modes, num_n_modes = rsurfacecc.shape
+    if n_min is None:
+        n_min = -(num_n_modes - 1) / 2
+    angle, m_idx, n_idx = _mode_angle(
+        num_m_modes, num_n_modes, nfp, tor_angle, pol_angle, n_min,
+        m_min)
+    cosine = jnp.cos(angle)
+    sine = jnp.sin(angle)
+    phi_frequency = n_idx[None, :] * nfp
+    theta_frequency = m_idx[:, None]
+
+    radius = jnp.sum(rsurfacecc * cosine)
+    height = jnp.sum(zsurfacecs * sine)
+    radius_phi = jnp.sum(rsurfacecc * phi_frequency * sine)
+    height_phi = jnp.sum(-zsurfacecs * phi_frequency * cosine)
+    radius_theta = jnp.sum(-rsurfacecc * theta_frequency * sine)
+    height_theta = jnp.sum(zsurfacecs * theta_frequency * cosine)
+
+    cos_phi = jnp.cos(tor_angle)
+    sin_phi = jnp.sin(tor_angle)
+    point = jnp.stack((radius * cos_phi, radius * sin_phi, height))
+    tangent_phi = jnp.stack((
+        radius_phi * cos_phi - radius * sin_phi,
+        radius_phi * sin_phi + radius * cos_phi,
+        height_phi,
+    ))
+    tangent_theta = jnp.stack((
+        radius_theta * cos_phi,
+        radius_theta * sin_phi,
+        height_theta,
+    ))
+    return point, jnp.cross(tangent_phi, tangent_theta)
+
+
 def _ntor_from_coefficients(coefficients):
     return (coefficients.shape[1] - 1) // 2
 

+  SUBROUTINE check_optional_variable_status(status)
+
+    IMPLICIT NONE
+
+    INTEGER, INTENT(IN) :: status
+
+
+    IF((status /= NF90_NOERR) .AND. (status /= NF90_ENOTVAR)) CALL check(status)
+
+
+  END SUBROUTINE check_optional_variable_status
+
+  SUBROUTINE check_variable_schema(ncid, varid, expected_type, expected_dimids, variable_name)
+
+    IMPLICIT NONE
+
+    INTEGER, INTENT(IN) :: ncid,            &
+      &                    varid,           &
+      &                    expected_type,   &
+      &                    expected_dimids(:)
+    CHARACTER(LEN=*), INTENT(IN) :: variable_name
+    INTEGER :: actual_type,                    &
+      &        actual_ndims,                   &
+      &        actual_dimids(NF90_MAX_VAR_DIMS)
+
+
+    CALL check(NF90_INQUIRE_VARIABLE(ncid, varid, xtype=actual_type, ndims=actual_ndims, &
+      & dimids=actual_dimids))
+    IF((actual_type /= expected_type) .OR. (actual_ndims /= SIZE(expected_dimids)))THEN
+      CALL schema_abort("incompatible " // TRIM(variable_name) // " type or rank")
+    END IF
+    IF(ANY(actual_dimids(1:actual_ndims) /= expected_dimids))THEN
+      CALL schema_abort("incompatible " // TRIM(variable_name) // " dimensions")
+    END IF
+
+
+  END SUBROUTINE check_variable_schema
+
+  SUBROUTINE schema_abort(message)
+
+    IMPLICIT NONE
+
+    CHARACTER(LEN=*), INTENT(IN) :: message
+    INTEGER :: abort_ierr
+
+
+    PRINT *, "write_eq_field: ", TRIM(message)
+    CALL MPI_ABORT(MPI_COMM_WORLD, 1, abort_ierr)
+
+
+  END SUBROUTINE schema_abort

+  SUBROUTINE diagnostic_current_rate_cut (rate_cut)
+
+    IMPLICIT NONE
+
+    REAL(DP), INTENT(OUT) :: rate_cut(ntor)
+    REAL(DP) :: rate_cut_l(ntor), &
+      &         current_scale,    &
+      &         dbr_increment_dz, &
+      &         dbz_increment_dr
+    INTEGER :: i,  &
+      &        j,  &
+      &        k,  &
+      &        kg, &
+      &        ierr
+
+
+    CALL bcondition
+    CALL sendreciv_array(dbr1dt)
+    CALL sendreciv_array(dbphi1dt)
+    CALL sendreciv_array(dbz1dt)
+
+    rate_cut_l(:) =  0.0_DP
+    current_scale =  rmaj0 * b0 * dr * dz / (mu0 * dt_b)
+
+    DO k=ksta2,kend2
+      kg =  ksta + k - 1
+      DO j=jsta2,jend2
+        DO i=ista2,iend2
+          IF(ss(i,j,k) < jcuts)THEN
+            dbr_increment_dz =  cz(1) * dbr1dt(i,j+2,k) + cz(2) * dbr1dt(i,j+1,k) &
+              &               + cz(3) * dbr1dt(i,j-1,k) + cz(4) * dbr1dt(i,j-2,k)
+            dbz_increment_dr =  cr(1) * dbz1dt(i+2,j,k) + cr(2) * dbz1dt(i+1,j,k) &
+              &               + cr(3) * dbz1dt(i-1,j,k) + cr(4) * dbz1dt(i-2,j,k)
+            rate_cut_l(kg) =  rate_cut_l(kg) + current_scale * (dbr_increment_dz - dbz_increment_dr)
+          END IF
+        END DO
+      END DO
+    END DO
+
+    CALL MPI_REDUCE(rate_cut_l, rate_cut, ntor, MPI_REAL8, MPI_SUM, 0, MPI_COMM_WORLD, ierr)
+
+
+  END SUBROUTINE diagnostic_current_rate_cut
 

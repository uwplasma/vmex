+      WRITE(*,'(A,4ES24.15)') 'CURRENT_DRIVE_RATE_RESPONSE', rate_response(1), MINVAL(rate_response), &
+        & SUM(rate_response) / ntor, MAXVAL(rate_response)
+      WRITE(*,'(A,4ES24.15)') 'CURRENT_DRIVE_RATE_IMPOSED', rate_imposed(1), MINVAL(rate_imposed), &
+        & SUM(rate_imposed) / ntor, MAXVAL(rate_imposed)
+      WRITE(*,'(A,4ES24.15)') 'CURRENT_DRIVE_RATE_CLEANING', rate_cleaning(1), MINVAL(rate_cleaning), &
+        & SUM(rate_cleaning) / ntor, MAXVAL(rate_cleaning)
+      WRITE(*,'(A,4ES24.15)') 'CURRENT_DRIVE_RATE_SUM', rate_sum(1), MINVAL(rate_sum), &
+        & SUM(rate_sum) / ntor, MAXVAL(rate_sum)
+      WRITE(*,'(A,4ES24.15)') 'CURRENT_DRIVE_RATE_TOTAL', rate_total(1), MINVAL(rate_total), &
+        & SUM(rate_total) / ntor, MAXVAL(rate_total)
+      WRITE(*,'(A,2ES24.15)') 'CURRENT_DRIVE_RATE_CLOSURE_MAX_ABS_REL', MAXVAL(ABS(rate_closure)), &
